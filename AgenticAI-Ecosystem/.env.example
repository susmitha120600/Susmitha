# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
MODEL_NAME=gpt-4o
TEMPERATURE=0.1
MAX_TOKENS=4096

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# Vector Database Configuration
VECTOR_DB_TYPE=faiss
FAISS_INDEX_PATH=./data/vectorstore/faiss_index
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=agenticai

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenticai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# Agent Configuration
MAX_ITERATIONS=3
QUALITY_THRESHOLD=0.85
ENABLE_SELF_CORRECTION=true
HALLUCINATION_THRESHOLD=0.15
CONFIDENCE_THRESHOLD=0.75

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
RERANK_TOP_K=3
ENABLE_HYBRID_SEARCH=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# LangSmith (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=agenticai-ecosystem

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
